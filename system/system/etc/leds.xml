<leds platform="alison">
  <file name="led" path="/sys/devices/platform/leds-mstar/leds/tv_led/tv_led_set" />

  <pattern name="all_off">
    <file name="led">3</file>
  </pattern>
  <pattern name="led_1_solid">
    <file name="led">2</file>
  </pattern>
  <pattern name="led_1_off">
    <file name="led">3</file>
  </pattern>
  <pattern name="led_1_breathe">
    <file name="led">4</file>
  </pattern>
  <pattern name="led_1_single-blink">
    <file name="led">5</file>
  </pattern>
  <pattern name="led_1_blink">
    <file name="led">6</file>
  </pattern>
  <pattern name="led_1_single-blink-on">
    <file name="led">8</file>
  </pattern>
  <pattern name="led_2_solid">
    <file name="led">9</file>
  </pattern>
  <pattern name="led_2_off">
    <file name="led">10</file>
  </pattern>
  <pattern name="led_2_breathe">
    <file name="led">11</file>
  </pattern>
  <pattern name="led_2_single-blink">
    <file name="led">12</file>
  </pattern>
  <pattern name="led_2_blink">
    <file name="led">13</file>
  </pattern>
  <pattern name="led_2_single-blink-on">
    <file name="led">14</file>
  </pattern>

  <state name="BOOTING"        pattern="led_1_breathe"	priority="1000" timeout="0" />
  <state name="TEMP_WARNING"   pattern="led_1_solid"	priority="500"  timeout="0" />
  <state name="BT_DISCOVERING" pattern="led_1_breathe"	priority="720"  timeout="60000" />
  <state name="BT_PAIRING"     pattern="led_1_blink"	priority="710"  timeout="60000" />
  <state name="BT_CONNECTING"  pattern="led_1_blink"	priority="700"  timeout="60000" />
  <state name="FACTORY_RESET"  pattern="led_1_blink"	priority="600"  timeout="60000" />
  <state name="STANDBY"        pattern="led_1_single-blink-on"   priority="400"  timeout="0" />

  <intent action="android.intent.action.BOOT_COMPLETED">
    <deactivate state="BOOTING" />
  </intent>
  <intent action="com.amazon.tv.settings.BACKUP_AND_RESET_SETTINGS_FROM_REMOTE">
    <activate state="FACTORY_RESET" />
  </intent>
  <intent action="com.amazon.tv.settings.BACKUP_AND_RESET_CANCELED">
    <deactivate state="FACTORY_RESET" />
  </intent>
  <intent action="android.bluetooth.adapter.action.DISCOVERY_STARTED">
    <activate state="BT_DISCOVERING" />
  </intent>
  <intent action="android.bluetooth.adapter.action.DISCOVERY_FINISHED">
    <deactivate state="BT_DISCOVERING" />
  </intent>
  <intent action="android.bluetooth.device.action.BOND_STATE_CHANGED">
    <activate state="BT_PAIRING" extra="android.bluetooth.device.extra.BOND_STATE" type="Integer" value="11"/>
    <deactivate state="BT_PAIRING" extra="android.bluetooth.device.extra.PREVIOUS_BOND_STATE" type="Integer" value="11"/>
  </intent>
  <intent action="android.bluetooth.adapter.action.CONNECTION_STATE_CHANGED">
    <activate state="BT_CONNECTING" extra="android.bluetooth.adapter.extra.CONNECTION_STATE" type="Integer" value="1" /> 
    <deactivate state="BT_CONNECTING" extra="android.bluetooth.adapter.extra.PREVIOUS_CONNECTION_STATE" type="Integer" value="1" />
  </intent>
  <intent action="com.amazon.android.service.wifi.CONNECTION_STATUS">
    <deactivate state="BT_CONNECTING" />
    <activate state="BT_CONNECTING" extra="connection_state" type="Integer" value="1" />
  </intent>
  <intent action="amazon.intent.action.THERMAL_EVENT">
    <activate  state="TEMP_WARNING" extra="amazon.intent.extra.THERMAL_STATE" type="Integer" value="1" />
    <deactivate state="TEMP_WARNING" extra="amazon.intent.extra.THERMAL_STATE" type="Integer" value="0" />
  </intent>

</leds>
