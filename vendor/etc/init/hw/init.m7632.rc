import /vendor/etc/init/hw/init.m7632.usb.rc
import init.whad_cc.rc
import init.iperftun.rc

on early-init
    mount debugfs debugfs /sys/kernel/debug
    # Fix lockedmem limit for bpf createMap
    setrlimit 8 10485760 10485760
    restorecon /fscc_config.txt

on init
    export EXTERNAL_STORAGE /mnt/sdcard
    symlink /sdcard /mnt/sdcard

    # usb/other sdcard/iso/samba mount point
    mkdir /mnt/usb 0775 root system
    mkdir /mnt/other_sdcard 0775 root system
    mkdir /mnt/iso 0775 root system
    mkdir /mnt/samba 0775 root system

    # DFB use socket mode for 64bit kernel
    mkdir /dev/shm
    mount -t tmpfs tmpfs /dev/shm

    mkdir /mnt/vendor 0775 root root
    mkdir /mnt/vendor/tvservice 0775 root root
    mkdir /mnt/vendor/linux_rootfs 0775 root root
    mkdir /mnt/vendor/3rd 0775 root root

    # initialize the default value of memory region index
    write /dev/cpuset/memory_allocator_idx 0
    write /dev/cpuset/system-background/memory_allocator_idx 1
    write /dev/cpuset/background/memory_allocator_idx 1
    write /dev/cpuset/foreground/memory_allocator_idx 0
    write /dev/cpuset/top-app/memory_allocator_idx 0

    # reserve CPU0 for top-app/kernel/irqs
    write /dev/cpuset/top-app/cpus 0-3
    write /dev/cpuset/foreground/cpus 0-3
    write /dev/cpuset/background/cpus 2
    write /dev/cpuset/system-background/cpus 1-3
    write /dev/cpuset/restricted/cpus 1-2

    export DOWNLOAD_CACHE /cache

    # set min watermark to 16MB (default is 5.086MB)
    write /proc/sys/vm/min_free_kbytes 16384

on early-fs
    start devcfg

on fs
    exec - root drmrpc -- /system/bin/resize2fs -f /dev/block/platform/mstar_mci.0/by-name/userdata
    mount_all /vendor/etc/fstab.m7632
    mount ext4 loop@/vendor/tvservice.img /mnt/vendor/tvservice ro
    mount squashfs loop@/vendor/linux_rootfs_a.img /mnt/vendor/linux_rootfs ro
    mount squashfs loop@/vendor/3rd_a.img /mnt/vendor/3rd ro

on post-fs
    # start console service earlier here
    start console
    start devcfg-post-fs

on post-fs-data
    exec - root shell -- /system/bin/chcon u:object_r:tv_certificate_file:s0 /vendor/tvcertificate/hashkey.sign
    # boot time fs tune
    write /sys/block/mmcblk0/queue/iostats 0
    write /sys/block/mmcblk0/queue/read_ahead_kb 1024
    write /sys/block/loop0/queue/read_ahead_kb 1024
    write /sys/block/loop1/queue/read_ahead_kb 1024
    write /sys/block/loop2/queue/read_ahead_kb 1024
    write /sys/block/mmcblk0/queue/nr_requests 256
    write /sys/block/dm-0/queue/read_ahead_kb 1024
    write /sys/block/dm-1/queue/read_ahead_kb 1024
    # tune sched params
    write /proc/sys/kernel/sched_migration_cost_ns 100000
    write /proc/sys/kernel/sched_wakeup_granularity_ns 1000000
    write /proc/sys/kernel/sched_min_granularity_ns 1500000
    write /proc/sys/kernel/sched_latency_ns 1000000

    start fixup
    start product_fixup
    start set_adb_ip
    mkdir /data/vendor/wifi 0777 root root
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/misc/dhcp 0770 dhcp dhcp
    mkdir /data/vendor/core_dump 0660 root root
    chmod 0775 /data/vendor/misc/dhcp
    chown dhcp dhcp /data/vendor/misc/dhcp
    chown root system /sys/class/irblaster/irblaster1/enable
    chmod 0666 /sys/class/irblaster/irblaster1/enable

    # bluetooth LPM
    chown bluetooth net_bt_stack /proc/bluetooth/sleep/lpm
    chown bluetooth net_bt_stack /proc/bluetooth/sleep/btwrite
    # rfkill
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/type
    chown bluetooth net_bt_stack /sys/class/rfkill/rfkill0/state
    chown bluetooth net_bt_stack /sys/class/rfkill/rfkill0/type
    # bluetooth MAC address programming
    chown bluetooth net_bt_stack "/data/misc/bluetooth/bdaddr"

    chmod 0666 /sys/devices/virtual/pm/pm/PM_Info
    chmod 0666 /sys/devices/virtual/pm/pm/WakeCfg
    chmod 0666 /sys/devices/virtual/pm/pm/SARCfg
    chmod 0666 /sys/devices/virtual/pm/pm/WoBTCfg

    # Allow LightsHAL to change cpufreq governor
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    chown system system /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor
    chown system system /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor
    chown system system /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor
    chmod 664 /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    chmod 664 /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor
    chmod 664 /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor
    chmod 664 /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor

    # Allow the programs in the system group to write PM_WOL_EN.
    chown root system /sys/devices/virtual/pm/pm/PM_WOL_EN
    chmod 0664 /sys/devices/virtual/pm/pm/PM_WOL_EN

    # KSM options
    write /sys/kernel/mm/ksm/pages_to_scan 100
    write /sys/kernel/mm/ksm/sleep_millisecs 500
    write /sys/kernel/mm/ksm/run 1

    # Init permissions for partititon
    start init_partition

    # for led control from FireTVLEDManager
    chown root system /sys/class/leds/tv_led/tv_led_set

    # update verity state
    verity_update_state

    setprop vold.post_fs_data_done 1

    wait /data/vendor/tv_database_inited.ini 1
    wait_for_prop ro.vendor.media.codecs.fosext.ready true

    # set ConsumerIR timing
    setprop ro.vendor.consumerir.timing 1

on boot
    # limit core dump size to 1M (for vts use) and disable it by default
    setrlimit 4 0 1048576
    write /proc/sys/net/core/rmem_max 1310720
    write /proc/sys/net/core/wmem_max 1048576
    write /proc/sys/kernel/core_pattern /data/vendor/core_dump/coredump.%p.gz

    # check store mode status after factory reset
    start check_storemode

    # add DNS server rule for special cases
    start set_dns_server_rule

    # Move it to init.conn.rc
    # for mtk bluetooth
    #insmod /vendor/lib/modules/firmware_class.ko path="/vendor/firmware/"
    #insmod /vendor/lib/modules/uhid.ko
    #insmod /vendor/lib/modules/btmtk_usb.ko

    # start service to check non-actionable property service.bootanim.ext
    start bootanim_exit_check

#INA231 power monitor
    chown system system /sys/class/hwmon/hwmon0/power1_input
    chown system system /sys/class/hwmon/hwmon0/update_interval
    chown system system /sys/class/hwmon/hwmon0/shunt_resistor

# boot time tune
on property:sys.boot_completed=1
    write /sys/block/mmcblk0/queue/iostats 1
    write /sys/block/mmcblk0/queue/read_ahead_kb 128
    write /sys/block/loop0/queue/read_ahead_kb 128
    write /sys/block/loop1/queue/read_ahead_kb 128
    write /sys/block/loop2/queue/read_ahead_kb 128
    write /sys/block/mmcblk0/queue/nr_requests 128
    write /sys/block/dm-0/queue/read_ahead_kb 128
    write /sys/block/dm-1/queue/read_ahead_kb 128
#For AT boot completed String
    write /dev/kmsg "[finish boot] sys.boot_completed"
    start fscc
    start devcfg-check-als

# Allow CI team to disable STR for testing display cases.
# The test case requires device go to active standby mode after sending power key.
on property:persist.odm.hold.wakelock=y
    write /sys/power/wake_lock "disable_str"

on property:persist.odm.hold.wakelock=n
    write /sys/power/wake_unlock "disable_str"

on property:persist.odm.disable_rescue=true
    setprop persist.sys.disable_rescue true
# after launcher is displayed, trigger other drivers initialization
on property:init.svc.bootanim=stopped

on property:odm.hold.wakelock.idme=y
    write /sys/power/wake_lock disable_str_idme

on property:ro.vendor.mstar.dbc_name=dynamic_backlight
    insmod /vendor/lib/modules/dynamic_backlight.ko

on property:ro.vendor.mstar.dbc_name=dynamic_backlight_F
    insmod /vendor/lib/modules/dynamic_backlight_F.ko

on property:ro.vendor.mstar.dbc_name=dynamic_backlight_H
    insmod /vendor/lib/modules/dynamic_backlight_H.ko

on property:ro.vendor.mstar.dbc_name=dynamic_backlight_T
    insmod /product/lib/modules/dynamic_backlight_T.ko

on property:ro.vendor.mstar.dbc_name=dynamic_backlight_shelly
    insmod /vendor/lib/modules/dynamic_backlight_shelly.ko

on property:ro.vendor.mstar.dbc_name=dynamic_backlight_hailey
    insmod /vendor/lib/modules/dynamic_backlight_hailey.ko

# Move it to init.conn.rc
#on property:vendor.mtk.wifi.driver=mt7668
# mediatek 7668 wifi driver
    #insmod /vendor/lib/modules/firmware_class.ko path="/vendor/firmware/"
    #insmod /vendor/lib/modules/cfg80211.ko
    #insmod /vendor/lib/modules/wlan_mt76x8_usb_prealloc.ko
    #insmod /vendor/lib/modules/wlan_mt76x8_usb.ko

on property:vendor.mtk.wifi.driver=mt7662
# mediatek 76x2 wifi driver
    insmod /vendor/lib/modules/wlan.ko

# service to fixup things in early devices
service fixup /vendor/bin/fixup.sh
    class main
    group system drmrpc
    oneshot
    disabled
    seclabel u:r:fixup:s0

# product service to fixup things in early devices
service product_fixup /product/bin/fixup.sh
    class main
    group system drmrpc
    oneshot
    disabled
    seclabel u:r:fixup:s0

# service to populate readonly property
service devcfg /vendor/bin/devcfg.sh
    group system
    oneshot
    disabled
    seclabel u:r:devcfg:s0

# service to populate readonly property
service devcfg-post-fs /vendor/bin/devcfg-post-fs.sh
    group system
    oneshot
    disabled
    seclabel u:r:devcfg:s0

# check and load als service driver
service devcfg-check-als /vendor/bin/devcfg_check_als.sh
    group system
    oneshot
    disabled
    seclabel u:r:devcfg:s0

# service for optee
service optee /vendor/bin/tee-supplicant
    class main
    group system drmrpc
    shutdown critical
    seclabel u:r:tee:s0

#servie for intertaca
service intertaca /vendor/bin/intertaca
    class main
    user system
    group system drmrpc
    oneshot
    seclabel u:r:intertaca:s0

# service for common wificond
service wificond /system/bin/wificond
    class main
    user wifi
    group wifi net_raw net_admin

#add wireless related service
service fast_connect /vendor/bin/fast_connect
    class main
    oneshot
    seclabel u:r:fast_connect:s0

service wpa_supplicant /vendor/bin/hw/wpa_supplicant -g@android:wpa_wlan0 -G1010 -O/data/vendor/wifi/wpa/sockets -Dnl80211 -iwlan0 -c /vendor/etc/wifi/wpa_supplicant.conf -I /vendor/etc/wifi/wpa_supplicant_overlay.conf -N -Dnl80211 -ip2p0 -c /vendor/etc/wifi/p2p_supplicant.conf -puse_p2p_group_interface=1 -d
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service wpa_supplicantrt /vendor/bin/hw/wpa_supplicantrt -Dnl80211 -iwlan0 -c /data/vendor/misc/wifi/wpa.conf
    class main
    disabled
    oneshot
    seclabel u:r:wpa:s0

service p2p_supplicantrt /vendor/bin/hw/wpa_supplicantrt -Dnl80211 -iwlan0 -c /data/vendor/misc/wifi/p2p.conf -e /data/vendor/misc/wifi/entropy.bin
    class main
    disabled
    oneshot
    seclabel u:r:wpa:s0

service wpa_supplicant6k /vendor/bin/hw/wpa_supplicantat6k -iwlan0 -Dnl80211 -c /data/vendor/misc/wifi/wpa.conf
    class main
    disabled
    oneshot
    #seclabel u:r:wpa:s0

service p2p_supplicant6k /vendor/bin/hw/wpa_supplicantat6k -ip2p0 -Dnl80211 -c /data/vendor/misc/wifi/p2p.conf
    class main
    disabled
    oneshot
    seclabel u:r:wpa:s0

service dhcpcd /vendor/bin/dhcpcd -BK
    class main
    disabled
    oneshot

service dhcpcd_eth0 /vendor/bin/dhcpcd -BK
    class main
    disabled
    oneshot

service dhcpcd_wlan0 /vendor/bin/dhcpcd -BK
    class main
    disabled
    oneshot

service dhcpcd_p2p /vendor/bin/dhcpcd -BK
    class main
    disabled
    oneshot
#support ipv6
	
on property:service.dhcp6c_wlan0.enable=0    
    stop dhcp6c_wlan0    

on property:service.dhcp6c_wlan0.enable=1
    start dhcp6c_wlan0

service bugreport /system/bin/dumpstate -d -p -B -z \
        -o /data/user_de/0/com.android.shell/files/bugreports/bugreport
    class main
    disabled
    oneshot

# Factory software component check.
service fscc /vendor/bin/fscc --use-restful-api
    group shell drmrpc
    oneshot
    disabled

# set dongle adb ip based on IDME value
service set_adb_ip /vendor/bin/set_adb_ip.sh
    class main
    group shell system
    oneshot
    disabled
    seclabel u:r:set_adb_ip:s0

on property:persist.odm.sys.str.delay=*
    setprop sys.str.delay_before_str ${persist.odm.sys.str.delay}

on property:persist.odm.led.behaviour=1
    write /dev/kmsg "enable led standby"
    write /sys/kernel/mik/MI_LED 1
    write /sys/class/leds/tv_led/tv_led_set 18

on property:persist.odm.led.behaviour=0
    write /dev/kmsg "disable led standby"
    write /sys/kernel/mik/MI_LED 0
    write /sys/class/leds/tv_led/tv_led_set 19

# Init permissions for partition
service init_partition /vendor/bin/init_partition.sh
    class main
    group shell system drmrpc
    oneshot
    disabled
    seclabel u:r:init_partition:s0

# check storemode status, clear usr_flags after factory reset
service check_storemode /vendor/bin/set_storemode.sh 2
    class main
    group system
    oneshot
    disabled
    seclabel u:r:set_storemode:s0

service set_storemode /vendor/bin/set_storemode.sh 1
    class main
    group system
    oneshot
    disabled
    seclabel u:r:set_storemode:s0

service clear_storemode /vendor/bin/set_storemode.sh 0
    class main
    group system
    oneshot
    disabled
    seclabel u:r:set_storemode:s0

service set_usr_flags /vendor/bin/set_usr_flags.sh ${vendor.sys.storemode.usrflags}
    class main
    group system drmrpc
    oneshot
    disabled
    seclabel u:r:fixup:s0

on property:vendor.sys.storemode.set=1
    start set_storemode

on property:vendor.sys.storemode.clear=1
    start clear_storemode

on property:vendor.sys.storemode.usrflags=*
    start set_usr_flags

# service for presenting iommu memory usage in "dumpsys meminfo"
service other_iommu /vendor/bin/other_iommu
    class main
    user system
    group system

# service for presenting cma memory usage in "dumpsys meminfo"
service other_cma /vendor/bin/other_cma
    class main
    user system
    group system

on property:vendor.sysctl.ip_loc_res_ports=*
    write /proc/sys/net/ipv4/ip_local_reserved_ports ${vendor.sysctl.ip_loc_res_ports}

service set_dns_server_rule /vendor/bin/set_dns_server_rule.sh
    class main
    group shell system
    oneshot
    disabled
    seclabel u:r:set_dns_server_rule:s0

service bootanim_exit_check /vendor/bin/bootanim_exit_check.sh
    class main
    group shell system
    oneshot
    disabled
    seclabel u:r:bootanim_exit_check:s0
