service vendor.camera-provider-2-4-ext /vendor/bin/hw/vendor.mediatek.camera.provider@2.4-external-service
    interface vendor.mediatek.camera.provider@2.4::IMtkCameraProvider external/0
    class hal
    user cameraserver
    group audio camera input drmrpc usb
    ioprio rt 4
    capabilities SYS_NICE
    writepid /dev/cpuset/camera-daemon/tasks /dev/stune/top-app/tasks
